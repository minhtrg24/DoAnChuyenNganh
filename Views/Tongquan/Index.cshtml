@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tổng quan - Quản lý tiệm Internet</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background: #f4f6f9;
            font-family: Arial, sans-serif;
        }

        .sidebar {
            width: 240px;
            min-height: 100vh;
            background: pink   ;
            color: Black;
            position: fixed;
            top: 0;
            left: 0;
            padding: 24px 15px;
        }

        .brand {
            font-size: 20px;
            font-weight: bold;
            padding: 0 10px 28px;
        }

        .menu a {
            display: block;
            color: black   ;
            text-decoration: none;
            padding: 12px 14px;
            margin-bottom: 6px;
            border-radius: 8px;
        }

        .menu a:hover,
        .menu a.active {
            background: #2563eb;
            color: white;
        }

        .main {
            margin-left: 240px;
            padding: 25px;
        }

        .topbar {
            background: white;
            padding: 18px 22px;
            border-radius: 12px;
            margin-bottom: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .stat-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
            height: 100%;
        }

        .stat-number {
            font-size: 28px;
            font-weight: bold;
        }

        .section-card {
            background: white;
            padding: 22px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
        }

        .computer-card {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 16px;
            text-align: center;
        }

        .computer-card h6 {
            font-weight: bold;
        }

        @@media (max-width: 768px) {
            .sidebar {
                position: static;
                width: 100%;
                min-height: auto;
            }

            .menu {
                display: flex;
                flex-wrap: wrap;
                gap: 4px;
            }

            .menu a {
                padding: 8px 10px;
            }

            .main {
                margin-left: 0;
                padding: 15px;
            }
        }
    </style>
</head>

<body>
    <aside class="sidebar">
        <div class="brand">🎮 Quản Lý Net</div>

        <nav class="menu">
            <a href="#" class="active">📊 Tổng quan</a>
            <a href="#">🖥️ Quản lý máy tính</a>
            <a href="#">👥 Khách hàng</a>
            <a href="#">💰 Nạp tiền</a>
            <a href="#">🥤 Sản phẩm</a>
            <a href="#">🧾 Hóa đơn</a>
            <a href="#">📈 Báo cáo doanh thu</a>
            <a href="#">⚙️ Cài đặt</a>
        </nav>
    </aside>

    <main class="main">
        <header class="topbar">
            <div>
                <h4 class="mb-1">Tổng quan hệ thống</h4>
                <small class="text-secondary">
                    Theo dõi hoạt động của tiệm Internet
                </small>
            </div>

            <div class="text-end">
                <strong>Nhân viên quản lý</strong>
                <div class="text-secondary small">Quản trị viên</div>
            </div>
        </header>

        <h5 class="mb-3">Thống kê hôm nay</h5>

        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card stat-card">
                    <div class="card-body">
                        <div class="text-secondary">Tổng số máy</div>
                        <div class="stat-number text-primary">@ViewBag.TongSoMay</div>
                        <small>Máy tính trong tiệm</small>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card stat-card">
                    <div class="card-body">
                        <div class="text-secondary">Máy đang chơi</div>
                        <div class="stat-number text-success">@ViewBag.MayDangChoi</div>
                        <small>Đang có khách sử dụng</small>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card stat-card">
                    <div class="card-body">
                        <div class="text-secondary">Máy trống</div>
                        <div class="stat-number text-warning">@ViewBag.MayTrong</div>
                        <small>Sẵn sàng phục vụ</small>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card stat-card">
                    <div class="card-body">
                        <div class="text-secondary">Doanh thu hôm nay</div>
                        <div class="stat-number text-danger"
                             style="font-size: 23px">
                            @(((decimal)ViewBag.DoanhThuHomNay).ToString("N0"))đ
                        </div>
                        <small>Số liệu minh họa</small>
                    </div>
                </div>
            </div>
        </div>

        <section class="section-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Trạng thái máy tính</h5>
                <button class="btn btn-primary btn-sm"
                        onclick="alert('Chức năng sẽ được xây dựng sau')">
                    + Thêm máy
                </button>
            </div>

            <div class="row g-3">
                <div class="col-6 col-md-4 col-xl-3">
                    <div class="computer-card">
                        <h6>Máy NET01</h6>
                        <span class="badge bg-success">Đang sử dụng</span>
                        <p class="mt-2 mb-0 small text-secondary">
                            Thời gian: 01:25
                        </p>
                    </div>
                </div>

                <div class="col-6 col-md-4 col-xl-3">
                    <div class="computer-card">
                        <h6>Máy NET02</h6>
                        <span class="badge bg-secondary">Máy trống</span>
                        <p class="mt-2 mb-0 small text-secondary">
                            Chưa có khách
                        </p>
                    </div>
                </div>

                <div class="col-6 col-md-4 col-xl-3">
                    <div class="computer-card">
                        <h6>Máy NET03</h6>
                        <span class="badge bg-success">Đang sử dụng</span>
                        <p class="mt-2 mb-0 small text-secondary">
                            Thời gian: 00:45
                        </p>
                    </div>
                </div>

                <div class="col-6 col-md-4 col-xl-3">
                    <div class="computer-card">
                        <h6>Máy NET04</h6>
                        <span class="badge bg-danger">Bảo trì</span>
                        <p class="mt-2 mb-0 small text-secondary">
                            Đang kiểm tra
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section class="section-card">
            <h5 class="mb-3">Giao dịch gần đây</h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Mã giao dịch</th>
                            <th>Khách hàng</th>
                            <th>Loại giao dịch</th>
                            <th>Số tiền</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>GD001</td>
                            <td>Nguyễn Văn A</td>
                            <td>Nạp tiền</td>
                            <td>100.000đ</td>
                            <td><span class="badge bg-success">Thành công</span></td>
                        </tr>

                        <tr>
                            <td>GD002</td>
                            <td>Trần Văn B</td>
                            <td>Nạp tiền</td>
                            <td>50.000đ</td>
                            <td><span class="badge bg-success">Thành công</span></td>
                        </tr>

                        <tr>
                            <td>GD003</td>
                            <td>Lê Văn C</td>
                            <td>Nạp tiền</td>
                            <td>200.000đ</td>
                            <td><span class="badge bg-warning text-dark">Chờ xử lý</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</body>
</html>
