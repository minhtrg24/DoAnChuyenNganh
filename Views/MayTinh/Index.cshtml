@model IEnumerable<DoAnChuyenNganh.Models.Computer>

@{
    Layout = null;
    ViewData["Title"] = "Quản lý máy tính";
}
@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success">
        @TempData["ThongBao"]
    </div>
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quản lý máy tính - NET MANAGER</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <style>
        body {
            margin: 0;
            background: #f3f5f9;
            font-family: Arial, sans-serif;
        }

        .sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            width: 250px;
            padding: 28px 16px;
            background: pink;
            color: black;
        }

        .brand {
            font-size: 23px;
            font-weight: bold;
            margin: 0 12px 35px;
        }

        .sidebar a {
            display: block;
            color: black;
            text-decoration: none;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 8px;
        }

            .sidebar a:hover,
            .sidebar a.active {
                background: #2864e8;
            }

        .main {
            margin-left: 250px;
            padding: 28px;
        }

        .panel {
            background: white;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 4px 15px #0000000a;
        }

        .badge-status {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 6px;
            color: white;
            font-size: 12px;
        }

        @@media (max-width: 800px) {
            .sidebar {
                position: static;
                width: 100%;
            }

            .main {
                margin-left: 0;
                padding: 15px;
            }
        }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="brand">🎮 Quản Lý Net</div>
        <a href="/Tongquan/Index">📊 Tổng quan</a>
        <a class="active" href="/MayTinh/Index">🖥️ Quản lý máy tính</a>
        <a href="/KhachHang/Index">👥 Khách hàng</a>
        <a href="/NapTien/Index">💰 Nạp tiền</a>
        <a href="/SanPham/Index">🥤 Sản phẩm</a>
        <a href="/HoaDon/Index">🧾 Hóa đơn</a>
        <a href="/BaoCao/Index">📈 Báo cáo doanh thu</a>
    </aside>

    <main class="main">
        <div class="panel mb-4">
            <h2>Quản lý máy tính</h2>
            <p class="text-secondary mb-0">
                Danh sách máy tính lấy từ cơ sở dữ liệu tiệm net.
            </p>
        </div>

        <div class="panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>Danh sách máy</h4>
                <span class="badge text-bg-primary">
                    Tổng số: @Model.Count() máy
                </span>
            </div>
            <a href="/MayTinh/Them" class="btn btn-primary">
                + Thêm máy
            </a>
            
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Mã máy</th>
                            <th>Khu vực</th>
                            <th>Loại máy</th>
                            <th>Giá giờ</th>
                            
                            <th>Cập nhật trạng thái </th>
                            <th>Trạng thái</th>
                            <th>Chỉnh sửa</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var may in Model)
                        {
                            <tr>
                                <td><strong>@may.ComputerCode</strong></td>
                                <td>@(may.Zone?.ZoneName ?? "Chưa phân khu")</td>
                                <td>@may.ComputerType</td>
                                <td>@may.HourlyRate.ToString("N0") đ</td>
                                
                                <td>
                                    <form asp-controller="MayTinh"
                                          asp-action="CapNhatTrangThai"
                                          asp-route-id="@may.ComputerId"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <select name="trangThai"
                                                class="form-select form-select-sm d-inline-block"
                                                style="width: 145px;"
                                                onchange="this.form.submit()">

                                            <option value="AVAILABLE"
                                                    selected="@(may.Status == "AVAILABLE")">
                                                Máy trống
                                            </option>

                                            <option value="IN_USE"
                                                    selected="@(may.Status == "IN_USE")">
                                                Đang sử dụng
                                            </option>

                                            <option value="MAINTENANCE"
                                                    selected="@(may.Status == "MAINTENANCE")">
                                                Bảo trì
                                            </option>
                                        </select>
                                    </form>
                                </td>
                                <td>
                                    @{
                                        var trangThai = may.Status ?? "";
                                        var mau = trangThai == "AVAILABLE"
                                        ? "bg-success"
                                        : trangThai == "IN_USE"
                                        ? "bg-primary"
                                        : trangThai == "MAINTENANCE"
                                        ? "bg-danger"
                                        : "bg-secondary";

                                        var tenTrangThai = trangThai == "AVAILABLE"
                                        ? "Máy trống"
                                        : trangThai == "IN_USE"
                                        ? "Đang sử dụng"
                                        : trangThai == "MAINTENANCE"
                                        ? "Bảo trì"
                                        : trangThai;
                                    }
                                    <span class="badge @mau">@tenTrangThai</span>
                                </td>
                                <td>
                                    <a asp-controller="MayTinh"
                                       asp-action="Sua"
                                       asp-route-id="@may.ComputerId"
                                       class="btn btn-warning btn-sm">
                                        Sửa
                                    </a>
                                    <form asp-controller="MayTinh"
                                          asp-action="Xoa"
                                          asp-route-id="@may.ComputerId"
                                          method="post"
                                          style="display:inline;"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa máy này không?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="btn btn-danger btn-sm">
                                            Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <p class="text-secondary text-center">
                    Chưa có máy tính trong cơ sở dữ liệu.
                </p>
            }
        </div>
    </main>
</body>
</html>
