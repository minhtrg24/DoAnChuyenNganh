@model DoAnChuyenNganh.Models.Computer

@{
    Layout = null;
    var khuVucs = ViewBag.KhuVucs
        as IEnumerable<DoAnChuyenNganh.Models.ComputerZone>;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Thêm máy tính - NET MANAGER</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f3f5f9;
            font-family: Arial, sans-serif;
        }

        .form-container {
            max-width: 760px;
            margin: 45px auto;
            padding: 30px;
            background: white;
            border-radius: 14px;
            box-shadow: 0 4px 18px #0000000d;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="form-container">
            <h2 class="mb-2">Thêm máy tính</h2>
            <p class="text-secondary">Nhập thông tin máy tính mới.</p>

            <form asp-controller="MayTinh"
                  asp-action="Them"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ComputerCode" class="form-label">
                        Mã máy
                    </label>
                    <input asp-for="ComputerCode"
                           class="form-control"
                           placeholder="Ví dụ: PC005" />
                    <span asp-validation-for="ComputerCode"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ZoneId" class="form-label">
                        Khu vực
                    </label>
                    <select asp-for="ZoneId" class="form-select">
                        <option value="">-- Chọn khu vực --</option>

                        @if (khuVucs != null)
                        {
                            foreach (var khu in khuVucs)
                            {
                                <option value="@khu.ZoneId">
                                    @khu.ZoneName
                                </option>
                            }
                        }
                    </select>
                    <span asp-validation-for="ZoneId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ComputerType" class="form-label">
                        Loại máy
                    </label>
                    <select asp-for="ComputerType" class="form-select">
                        <option value="">-- Chọn loại máy --</option>
                        <option value="STANDARD">STANDARD</option>
                        <option value="STREAMING">STREAMING</option>
                        <option value="VIP">VIP</option>
                    </select>
                    <span asp-validation-for="ComputerType"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="HourlyRate" class="form-label">
                        Giá giờ (VNĐ)
                    </label>
                    <input asp-for="HourlyRate"
                           type="number"
                           min="0"
                           step="1000"
                           class="form-control" />
                    <span asp-validation-for="HourlyRate"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IpAddress" class="form-label">
                        Địa chỉ IP (không bắt buộc)
                    </label>
                    <input asp-for="IpAddress" class="form-control" />
                    <span asp-validation-for="IpAddress"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Specifications" class="form-label">
                        Cấu hình máy
                    </label>
                    <textarea asp-for="Specifications"
                              class="form-control"
                              rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">
                        Ghi chú
                    </label>
                    <textarea asp-for="Notes"
                              class="form-control"
                              rows="2"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    Lưu máy tính
                </button>

                <a asp-controller="MayTinh"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>
            </form>
        </div>
    </div>
</body>
</html>
